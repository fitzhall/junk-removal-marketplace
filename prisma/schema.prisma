generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AnalyticsEvent {
  id         String   @id
  eventType  String
  userId     String?
  sessionId  String?
  eventData  Json?
  pageUrl    String?
  referrer   String?
  ipAddress  String?
  userAgent  String?
  deviceType String?
  browser    String?
  os         String?
  country    String?
  region     String?
  city       String?
  createdAt  DateTime @default(now())
  User       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([eventType])
  @@index([sessionId])
  @@index([userId])
}

model Bid {
  id                String    @id
  quoteId           String
  providerId        String
  status            BidStatus @default(PENDING)
  bidAmount         Float
  estimatedDuration String?
  proposedDate      DateTime?
  message           String?
  notes             String?
  expiresAt         DateTime  @default(dbgenerated("(now() + '48:00:00'::interval)"))
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  Provider          Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  Quote             Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([providerId])
  @@index([quoteId])
  @@index([status])
}

model Booking {
  id               String        @id
  quoteId          String
  status           BookingStatus @default(PENDING)
  scheduledDate    DateTime
  timeSlot         String
  isUrgent         Boolean       @default(false)
  estimatedPrice   Float
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  pickupAddress    String?
  pickupZip        String?
  pickupCity       String?
  pickupState      String?
  confirmationCode String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  Quote            Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([customerEmail])
  @@index([quoteId])
  @@index([scheduledDate])
  @@index([status])
}

model Company {
  id                 String             @id
  slug               String             @unique
  businessName       String
  contactEmail       String
  contactPhone       String?
  logoUrl            String?
  primaryColor       String             @default("#3B82F6")
  secondaryColor     String             @default("#1E40AF")
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  subscriptionId     String?
  activationFee      Float              @default(500)
  monthlyFee         Float              @default(297)
  activationPaidAt   DateTime?
  trialEndsAt        DateTime?
  hasBookingFeature  Boolean            @default(false)
  hasAnalytics       Boolean            @default(false)
  maxQuotesPerMonth  Int                @default(1000)
  notificationEmail  String?
  webhookUrl         String?
  embedCode          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  customDomain       String?            @unique
  domainVerified     Boolean            @default(false)
  isActive           Boolean            @default(true)
  subdomain          String?            @unique
  subscriptionPlan   SubscriptionPlan   @default(STARTER)
  Provider           Provider[]
  Quote              Quote[]

  @@index([customDomain])
  @@index([isActive])
  @@index([slug])
  @@index([subdomain])
  @@index([subscriptionStatus])
}

model Job {
  id                String    @id
  quoteId           String    @unique
  providerId        String
  status            JobStatus @default(PENDING)
  scheduledDate     DateTime?
  scheduledTime     String?
  actualStartTime   DateTime?
  actualEndTime     DateTime?
  finalPrice        Float?
  providerPayout    Float?
  platformFee       Float?
  completionPhotos  Json?
  customerSignature String?
  notes             String?
  customerRating    Int?
  customerReview    String?
  providerRating    Int?
  providerFeedback  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  Provider          Provider  @relation(fields: [providerId], references: [id])
  Quote             Quote     @relation(fields: [quoteId], references: [id])

  @@index([providerId])
  @@index([scheduledDate])
  @@index([status])
}

model LeadDistribution {
  id             String     @id
  quoteId        String
  providerId     String
  status         LeadStatus @default(SENT)
  sentAt         DateTime   @default(now())
  viewedAt       DateTime?
  respondedAt    DateTime?
  responseReason String?
  bidAmount      Float?
  isWinner       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  Provider       Provider   @relation(fields: [providerId], references: [id])
  Quote          Quote      @relation(fields: [quoteId], references: [id])

  @@index([providerId])
  @@index([quoteId])
  @@index([status])
}

model PricingRule {
  id                     String   @id
  name                   String
  description            String?
  zipCode                String?
  city                   String?
  state                  String?
  isDefault              Boolean  @default(false)
  quarterTruckPrice      Float?
  halfTruckPrice         Float?
  threeQuarterTruckPrice Float?
  fullTruckPrice         Float?
  heavyItemFee           Float?
  stairsFee              Float?
  longCarryFee           Float?
  sameDayFee             Float?
  weekendFee             Float?
  peakTimeMultiplier     Float    @default(1.0)
  holidayMultiplier      Float    @default(1.5)
  priority               Int      @default(0)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime

  @@index([isActive, priority])
  @@index([state, city, zipCode])
}

model Provider {
  id                String             @id
  userId            String             @unique
  businessName      String
  businessAddress   String?
  businessPhone     String?
  licenseNumber     String?
  insuranceInfo     Json?
  rating            Float              @default(0)
  totalJobs         Int                @default(0)
  status            ProviderStatus     @default(PENDING)
  paymentTerms      Json?
  capabilities      Json?
  operatingHours    Json?
  autoBidEnabled    Boolean            @default(false)
  bidStrategy       String?
  bidPercentage     Float?
  bidFixedAmount    Float?
  maxJobsPerDay     Int                @default(5)
  preferredJobTypes Json?
  minJobValue       Float?
  maxJobValue       Float?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  companyId         String?
  Bid               Bid[]
  Job               Job[]
  LeadDistribution  LeadDistribution[]
  Company           Company?           @relation(fields: [companyId], references: [id])
  User              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ServiceArea       ServiceArea[]

  @@index([autoBidEnabled])
  @@index([companyId])
  @@index([rating])
  @@index([status])
}

model Quote {
  id                  String             @id
  userId              String?
  companyId           String?
  status              QuoteStatus        @default(DRAFT)
  customerName        String?
  customerEmail       String?
  customerPhone       String?
  pickupAddress       String?
  pickupZip           String?
  pickupCity          String?
  pickupState         String?
  photoUrls           Json?
  aiAnalysis          Json?
  estimatedVolume     VolumeSize?
  basePrice           Float?
  additionalFees      Json?
  totalPrice          Float?
  priceRangeMin       Float?
  priceRangeMax       Float?
  preferredDate       DateTime?
  preferredTimeWindow String?
  isUrgent            Boolean            @default(false)
  source              String?
  utmParams           Json?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime           @default(now())
  expiresAt           DateTime           @default(dbgenerated("(now() + '7 days'::interval)"))
  updatedAt           DateTime
  Bid                 Bid[]
  Booking             Booking[]
  Job                 Job?
  LeadDistribution    LeadDistribution[]
  Company             Company?           @relation(fields: [companyId], references: [id])
  User                User?              @relation(fields: [userId], references: [id])
  QuoteItem           QuoteItem[]

  @@index([companyId])
  @@index([createdAt])
  @@index([pickupZip])
  @@index([status])
  @@index([userId])
}

model QuoteItem {
  id                      String   @id
  quoteId                 String
  itemType                String
  itemDescription         String?
  quantity                Int      @default(1)
  aiConfidence            Float?
  requiresSpecialHandling Boolean  @default(false)
  estimatedWeightLbs      Int?
  dimensions              Json?
  createdAt               DateTime @default(now())
  Quote                   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model ServiceArea {
  id             String   @id
  providerId     String
  zipCode        String
  city           String
  state          String
  country        String   @default("US")
  maxRadiusMiles Int      @default(25)
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  Provider       Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([city, state])
  @@index([zipCode])
}

model User {
  id             String           @id
  email          String           @unique
  hashedPassword String?
  phone          String?
  name           String?
  role           Role             @default(CUSTOMER)
  emailVerified  DateTime?
  phoneVerified  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  AnalyticsEvent AnalyticsEvent[]
  Provider       Provider?
  Quote          Quote[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ProviderStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum QuoteStatus {
  DRAFT
  PENDING
  SENT
  ACCEPTED
  BOOKED
  EXPIRED
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum SubscriptionPlan {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum VolumeSize {
  QUARTER
  HALF
  THREE_QUARTER
  FULL
  MULTIPLE
}
